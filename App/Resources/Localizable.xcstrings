    "Account and security notices are always delivered. Everything else can be silenced without leaving the app.": {
      "comment": "Notification preferences footnote.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account and security notices are always delivered. Everything else can be silenced without leaving the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avis de compte et de sécurité sont toujours transmis. Tout le reste peut être coupé sans quitter l’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account- en beveiligingsmeldingen worden altijd bezorgd. Al de rest kun je dempen zonder de app te verlaten."
          }
        }
      }
    },
