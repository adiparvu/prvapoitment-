    "Add a card once and every future booking is one tap away. Apple Pay works without saving anything.": {
      "comment": "Payment methods empty state message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a card once and every future booking is one tap away. Apple Pay works without saving anything."
