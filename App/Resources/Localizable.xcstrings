        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une carte une fois et chaque réservation se fait ensuite en un geste. Apple Pay fonctionne sans rien enregistrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg één keer een kaart toe en elke volgende afspraak is één tik verwijderd. Apple Pay werkt zonder iets te bewaren."
          }
        }
      }
    },
